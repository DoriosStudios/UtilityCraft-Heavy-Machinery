{
    "format_version": "1.10.0",
    "minecraft:client_entity": {
        "description": {
            "identifier": "utilitycraft:gas_turbine_rotor",
            "materials": {
                "default": "entity_alphatest"
            },
            "textures": {
                "default": "textures/entity/gas_turbine_rotor"
            },
            "geometry": {
                "default": "geometry.utilitycraft.gas_turbine_rotor"
            },
            "animations": {
                "rotor": "animation.utilitycraft.gas_turbine.rotor"
            },
            "scripts": {
                "initialize": [
                    "v.turbine_angle = 0.0;"
                ],
                "pre_animation": [
                    "v.turbine_height = q.has_property('utilitycraft:height') ? q.property('utilitycraft:height') : 0.0;",
                    "v.turbine_radius = q.has_property('utilitycraft:radius') ? q.property('utilitycraft:radius') : 0.0;",
                    "v.turbine_speed = q.has_property('utilitycraft:speed') ? q.property('utilitycraft:speed') : 0.0;",
                    "v.turbine_angle = math.mod(v.turbine_angle + q.delta_time * v.turbine_speed * 720.0, 360.0);"
                ],
                "animate": [
                    "rotor"
                ]
            },
            "render_controllers": [
                "controller.render.utilitycraft.gas_turbine_rotor"
            ]
        }
    }
}
