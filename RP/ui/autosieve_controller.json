                    "offset": [
                        86,
                        49
                    ],
                    "collection_index": 26
                }
            },
            {
                "output_right_top@common.container_item": {
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [
                        104,
                        13
                    ],
                    "collection_index": 17
                }
            },
            {
                "output_right_middle@common.container_item": {
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [
                        104,
                        31
                    ],
                    "collection_index": 22
                }
            },
            {
                "output_right_bottom@common.container_item": {
                    "anchor_from": "top_middle",
                    "anchor_to": "top_middle",
                    "offset": [
                        104,
                        49
                    ],
                    "collection_index": 27
                }
            },
            {
                "output_grid_outline": {
                    "type": "image",
                    "texture": "textures/ui/slots/output_slot",
