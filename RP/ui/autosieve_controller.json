{
    "namespace": "autosieve_controller",
    "flipbook_animation": {
        "anim_type": "flip_book",
        "frame_count": 8,
        "frame_step": 0,
        "fps": 1,
        "easing": "linear",
        "initial_uv": [0, 0]
    },
